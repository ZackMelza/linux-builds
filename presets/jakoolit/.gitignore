**/UserConfigs/Host.conf
**/.initial_startup_done
**/wallpaper_effects/.wallpaper_current
**/wallpaper_effects/.wallpaper_modified
**/wallust/wallust-hyprland.conf
**/monitors.conf
**/workspaces.conf
/active/

# Profile trees should contain only real profile-specific overrides. The shared
# JaKooLit files live in common/ and active/ is generated by set-hypr-profile.sh.
/desktop/**
!/desktop/
!/desktop/UserConfigs/
!/desktop/UserConfigs/Host.conf.example
!/desktop/UserScripts/
!/desktop/UserScripts/WallpaperAutoChange.sh
!/desktop/UserScripts/WallpaperRandom.sh

/laptop/**
!/laptop/
!/laptop/UserConfigs/
!/laptop/UserConfigs/Host.conf.example
!/laptop/UserScripts/
!/laptop/UserScripts/WallpaperAutoChange.sh
!/laptop/UserScripts/WallpaperRandom.sh

.codex
