#!/usr/bin/env bash
set -euo pipefail

if command -v gsettings >/dev/null 2>&1; then
  gsettings set org.cinnamon.desktop.input-sources sources "[('xkb', 'us'), ('xkb', 'gr')]" >/dev/null 2>&1 || true
  gsettings set org.cinnamon.desktop.input-sources xkb-options "['grp:alt_shift_toggle', 'grp_led:scroll', 'terminate:ctrl_alt_bksp']" >/dev/null 2>&1 || true
fi

setxkbmap -layout us,gr -option ''
setxkbmap -layout us,gr -option grp:alt_shift_toggle,grp_led:scroll,terminate:ctrl_alt_bksp
