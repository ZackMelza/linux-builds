#!/usr/bin/env bash
set -euo pipefail

if xset -q 2>/dev/null | grep -A1 'XKB indicators' | grep -q 'Scroll Lock: *on'; then
  setxkbmap -layout us,gr -option ''
  setxkbmap -layout us,gr -option grp:alt_shift_toggle,grp_led:scroll,terminate:ctrl_alt_bksp
else
  setxkbmap -layout gr,us -option ''
  setxkbmap -layout gr,us -option grp:alt_shift_toggle,grp_led:scroll,terminate:ctrl_alt_bksp
fi
