#!/usr/bin/env bash
set -euo pipefail

if ! command -v rofi >/dev/null 2>&1; then
  exit 1
fi

choice="$(
  printf '%s\n' \
    'Log out' \
    'Suspend' \
    'Reboot' \
    'Power off' \
  | rofi -dmenu -p 'Power'
)"

case "$choice" in
  'Log out')
    i3-msg exit
    ;;
  Suspend)
    systemctl suspend
    ;;
  Reboot)
    systemctl reboot
    ;;
  'Power off')
    systemctl poweroff
    ;;
  *)
    exit 0
    ;;
esac
